# Site to finance-backend (server only)
BACKEND_BASE_URL=
# Optional legacy/fallback name when BACKEND_BASE_URL is unset
FINANCE_BACKEND_URL=
BACKEND_SHARED_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Clerk
# Production key must target clerk.vesconte.com after the Vesconte domain migration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public site URL. Production canonical: https://www.vesconte.com
# On Vercel this is optional: when unset, the site falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which the platform always provides and which
# follows a project rename. Set it explicitly once a custom domain is live.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI analyst
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Billing and webhook
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Scheduled refresh and alert delivery
MARKET_REFRESH_TOKEN=
SIGNAL_ALERT_CRON_TOKEN=
RESEND_API_KEY=
SIGNAL_ALERT_FROM_EMAIL=

# Optional product analytics/session replay
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Synthetic research: BFF default until operator rollout is verified
RESEARCH_SYNTHETIC_ENABLED=false
RESEARCH_BFF_SECRET=
NEXT_PUBLIC_RESEARCH_AUTH_MODE=bff
NEXT_PUBLIC_RESEARCH_API_BASE_URL=
# Local Docker only: same Clerk Development instance as keys above
CLERK_JWT_ISSUER=
CLERK_JWT_PUBLIC_KEY=
# FINANCE_REPOS_DIR=..
# FINANCE_BACKEND_PORT=18095
# FINANCE_POSTGRES_PORT=15432
